server {
    listen ${PORT};
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    resolver 8.8.8.8 1.1.1.1 valid=300s ipv6=off;
    resolver_timeout 5s;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied expired no-cache no-store private auth;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml application/javascript application/json;

    # Reverse proxy API requests to Service 1 (Unified Backend)
    # ^~ priority modifier ensures static regex doesn't capture /api/*.js (like /api/web-stats/tracker.js)
    location ^~ /api {
        proxy_pass ${BACKEND_API_URL}/api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host uwo24.com;
        proxy_cache_bypass $http_upgrade;
        proxy_ssl_server_name on;
    }

    # Reverse proxy short URL redirect routes
    location ^~ /m {
        proxy_pass ${BACKEND_API_URL}/m;
        proxy_http_version 1.1;
        proxy_set_header Host uwo24.com;
        proxy_ssl_server_name on;
    }

    # Cache static frontend assets exclusively under /assets/
    location ~* ^/assets/.*\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, no-transform";
    }

    # SPA routing fallback
    location / {
        try_files $uri $uri/ /index.html;
    }
}
